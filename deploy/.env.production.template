# Copied to .env on the VPS by deploy-app.sh. Fill in the blanks with
# `nano /opt/lapanza/app/.env`, then: sudo systemctl restart lapanza-admin
#
# Never paste these values into chat/AI tools -- type them directly on the
# server.

# Start on 'sandbox' even in production until you've placed a real test
# order and confirmed the full flow -- then flip to 'live'.
PAYFAST_MODE=sandbox

# Live (real money) merchant account -- from your Payfast dashboard:
# Settings -> Integration.
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=

# Sandbox (test) merchant account -- leave blank to use Payfast's shared
# public demo account (10000100).
PAYFAST_SANDBOX_MERCHANT_ID=
PAYFAST_SANDBOX_MERCHANT_KEY=
PAYFAST_SANDBOX_PASSPHRASE=

# Gmail address confirmation/notification emails send from, and an
# app-specific password (never the real account password) -- generate one
# at https://myaccount.google.com/apppasswords
GMAIL_USER=lapanzaonline@gmail.com
GMAIL_APP_PASSWORD=

# Single-VPS deploy: nginx serves the static site AND proxies /api + /admin
# from the same domain, so SITE_URL and API_URL are the same origin here.
SITE_URL=https://www.lapanza3d.co.za
API_URL=https://www.lapanza3d.co.za

# Meta WhatsApp Business Cloud API (admin "WhatsApp Updates" campaign
# sender). Requires a Meta Business Account, verified WhatsApp number, and
# an approved message template. Leave blank until that's set up --
# campaigns fail cleanly with "not configured" instead of pretending to send.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# rclone remote name (with trailing colon, e.g. "gdrive:") the daily backup
# job mirrors data/backups/ to -- see DEPLOY.md's "Off-server backups"
# section. Leave blank until that one-time setup is done; the on-server
# backup still runs regardless, this just skips the offsite copy.
BACKUP_RCLONE_REMOTE=

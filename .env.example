# Copy this file to .env and fill in real values. .env is gitignored --
# never commit real credentials.

# 'sandbox' or 'live'. Sandbox and live are separate credential sets below
# and never mix -- safe to fill in both and just toggle this.
PAYFAST_MODE=sandbox

# Live (real money) merchant account -- from your Payfast dashboard:
# Settings -> Integration.
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=

# Sandbox (test) merchant account -- your own sandbox account if you have
# one (dashboard-visible test transactions); falls back to Payfast's shared
# public demo account (10000100) if left blank.
PAYFAST_SANDBOX_MERCHANT_ID=
PAYFAST_SANDBOX_MERCHANT_KEY=
PAYFAST_SANDBOX_PASSPHRASE=

# Gmail address the confirmation email is sent from, and an app-specific
# password (never your real account password) -- generate one at
# https://myaccount.google.com/apppasswords
GMAIL_USER=lapanzaoline@gmail.com
GMAIL_APP_PASSWORD=

# The public URL of the STATIC site (where checkout.html/checkout-complete.html
# actually live), used to build Payfast's return_url/cancel_url. Needed
# whenever the browser reaches the API through a proxy or a different host
# than the one serving the site -- including local dev, where the browser
# talks to Vite (5173) which proxies /api to this server (8787): without
# this set, the request's own host (8787) gets used instead, and Payfast's
# post-payment redirect 404s (nothing static is served from this server at
# that path). Local dev: SITE_URL=http://localhost:5173
# Production once split across domains: SITE_URL=https://procomsolutions.co.za
SITE_URL=http://localhost:5173

# Where THIS backend itself is publicly reachable, for Payfast's ITN
# notify_url. Defaults to the request's own origin, which is correct for
# local dev and any single-host deploy -- only set this if the backend
# sits behind its own separate proxy/domain (the split-hosting scenario).
# API_URL=https://admin.procomsolutions.co.za
